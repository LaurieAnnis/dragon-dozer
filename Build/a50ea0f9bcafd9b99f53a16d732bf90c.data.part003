UNITY_BINDING(0) uniform ComputeSkinCBuffer {
	uvec4 g_VertCounts[2];
	uvec4 g_BatchOffsets[2];
	uvec4 g_PoseOffsets[2];
	uint g_poseBufferMaxIndex;
};
