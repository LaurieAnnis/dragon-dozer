                                    u_xlat7.z = u_xlat6.z;
                                    u_xlat10.z = dot(u_xlat7, u_xlat9);
                                    u_xlat1.yz = u_xlat2.xy;
                                    u_xlat10.w = dot(u_xlat8.xyz, u_xlat1.xyz);
